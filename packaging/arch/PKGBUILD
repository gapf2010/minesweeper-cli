# Maintainer: German Pulido <1203374+gapf2010@users.noreply.github.com>
pkgname=minesweeper-cli
pkgver=0.2.0
pkgrel=1
pkgdesc='Minesweeper games for the terminal: classic and pathfinder'
arch=('x86_64' 'aarch64' 'i686' 'armv7h')
url='https://github.com/gapf2010/minesweeper-cli'
license=('MIT')
depends=('glibc')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Run "updpkgsums" once the v$pkgver tag is on GitHub to fill this in.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  make CFLAGS="$CFLAGS" CPPFLAGS="$CPPFLAGS" LDFLAGS="$LDFLAGS"
}

check() {
  cd "$pkgname-$pkgver"
  make test
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
